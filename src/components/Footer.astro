---
import logo from "../../assets/lo_logo.svg";

const year = new Date().getFullYear();
---

<footer class="footer" data-footer-reveal>
  <div class="container-wide footer-grid">
    <div>
      <a class="brand footer-brand" href="/" aria-label="LokalOptimal Startseite">
        <img class="brand-logo footer-logo" src={logo.src} alt="" width="595" height="159" loading="lazy" decoding="async" />
      </a>
      <p>Google Business Profil Optimierung für lokale Unternehmen, die genau dort sichtbar werden wollen, wo Kund:innen suchen.</p>
    </div>

    <div>
      <h2>Leistungen</h2>
      <a href="/#quick-check">GBP Quick Check</a>
      <a href="/#preise">Pakete</a>
      <a href="/#kontakt">Kontakt</a>
    </div>

    <div>
      <h2>Rechtliches</h2>
      <a href="/impressum">Impressum</a>
      <a href="/datenschutz">Datenschutz</a>
      <a href="/agb">AGB</a>
    </div>
  </div>

  <div class="container-wide footer-bottom">
    <span>© {year} LokalOptimal</span>
    <span>Keine Ranking-Garantien. Saubere Optimierung nach aktuellen Best Practices.</span>
  </div>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>("[data-footer-reveal]");
  const canAnimateFooter =
    footer &&
    window.matchMedia("(max-width: 760px)").matches &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    "IntersectionObserver" in window;

  if (footer && canAnimateFooter) {
    footer.classList.add("footer-reveal-ready");

    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        footer.classList.add("is-visible");
        observer.disconnect();
      },
      { rootMargin: "0px 0px -4% 0px", threshold: 0.08 },
    );

    window.requestAnimationFrame(() => observer.observe(footer));
  }
</script>
