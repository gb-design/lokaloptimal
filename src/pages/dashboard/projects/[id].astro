---
export const prerender = false;

import DashboardLayout from "../../../layouts/DashboardLayout.astro";
import DashboardIcon from "../../../components/dashboard/DashboardIcon";
import ProjectEditor from "../../../components/dashboard/ProjectEditor";
import { getProject } from "../../../lib/dashboard/queries";
import { projectStatusLabels, type ProjectStatus } from "../../../lib/dashboard/types";

const id = Number(Astro.params.id);
if (!Number.isInteger(id)) return new Response("Ungültige Projekt-ID", { status: 400 });
const data = await getProject(Astro, id);
if (!data.project) return new Response("Projekt nicht gefunden", { status: 404 });
---

<DashboardLayout title={data.project.name} eyebrow="Kundenprojekt" description={`${projectStatusLabels[data.project.status as ProjectStatus]} · aus ${data.project.offer.offer_number || "Angebotsentwurf"}`}>
  <a slot="actions" class="dash-button secondary" href={`/dashboard/leads/${data.project.lead.id}`}>
    <DashboardIcon name="person" size={18} />
    Zum Lead
  </a>
  <ProjectEditor project={data.project} tasks={data.tasks} client:load />
</DashboardLayout>
