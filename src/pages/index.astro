---

<BaseLayout title={homeTitle} description={homeDescription} canonicalPath="/" structuredData={homeStructuredData}>
  <Header />

  <main>
    <section class="hero">
      <div class="container-wide hero-grid">
        <div class="hero-copy">
          <p class="hero-eyebrow">Google-Eintrag-Betreuung · Österreich</p>
          <h1 class="h1">Mehr Anrufe von Kunden aus <span class="text-blue">Ihrer Umgebung.</span></h1>
          <p class="hero-subline">LokalOptimal richtet Ihren Google-Eintrag ein und hält ihn aktuell. Für Betriebe in ganz Österreich.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href={calUrl} rel="noreferrer" data-cal-open>
              Kostenloses Erstgespräch buchen
              <span class="btn-icon"><span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></span>
            </a>
          </div>
          <p class="hero-microcopy">
            30 Minuten, unverbindlich · Pakete <a href="#preise">ab {formatEuro(packages[0].priceValue)}</a> im Festpreis
          </p>
        </div>

        <div class="hero-visual" data-hero-tilt>
          <HeroStreetMap />
          <div class="hero-tilt">
            <HeroProfileCard />
          </div>
        </div>
      </div>

      <div class="container trust-cluster">
        <div class="trust-row">
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Festpreise, offen auf der Seite</span>
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Ein persönlicher Ansprechpartner</span>
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Betreuung monatlich kündbar</span>
        </div>
        <span class="hero-founder">
          <img src={grfProfileImage.src} width="40" height="40" alt="" loading="eager" decoding="async" />
          <span><strong>Georg R.-F.</strong> · Gründer · Wien</span>
        </span>
      </div>
    </section>

    <section class="section steps-section" id="ablauf" aria-labelledby="steps-title" data-reveal>
      <div class="container-wide steps-layout">
        <header class="steps-intro">
          <span class="eyebrow"><span class="material-symbols-rounded" aria-hidden="true">route</span>So funktioniert's</span>
          <h2 class="h2" id="steps-title">Ihr Google-Eintrag ist oft der erste Eindruck – noch bevor jemand Ihre Tür sieht.</h2>
          <p class="lead">Wer einen Friseur, eine Ärztin oder einen Installateur in der Nähe sucht, entscheidet meist direkt bei Google: Wer hat gute Bewertungen? Wer hat aktuelle Fotos und die richtigen Öffnungszeiten? Viele Einträge werden einmal angelegt und dann vergessen. Genau dort gehen Anrufe an den Mitbewerber verloren – oft ohne dass Sie es merken.</p>
        </header>

        <ol class="future-principles steps-list" aria-label="In drei Schritten zu einem Google-Eintrag, der Kunden bringt">
          {steps.map((step, index) => (
            <li>
              <span class="future-index" aria-hidden="true">{String(index + 1).padStart(2, "0")}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section check-section" id="quick-check" data-reveal>
      <div class="container section-heading">
        <span class="map-icon" aria-hidden="true"><span>G</span></span>
        <h2 class="h2">Prüfen Sie Ihren Google-Eintrag – <span class="text-blue">kostenlos</span></h2>
        <p class="lead">Fügen Sie den Link zu Ihrem Google-Eintrag (Google Business Profil) ein. Sie sehen sofort, was fehlt.</p>
      </div>
      <div class="panel-shell widget-shell">
        <div class="panel-core widget-core">
          <GBPAuditWidget client:load />
        </div>
      </div>
    </section>

    <section class="section industries-section" data-reveal>
      <div class="container industries-grid">
        <div>
          <span class="eyebrow"><span class="material-symbols-rounded" aria-hidden="true">storefront</span>Für lokale Unternehmen</span>
          <h2 class="h2">Mehr Sichtbarkeit für jede Branche</h2>
          <p class="lead"><strong>LokalOptimal</strong> macht Betriebe dort sichtbar, wo Kund:innen aktiv suchen: auf Google.</p>
        </div>
        <div class="industry-marquee" aria-label="Branchen">
          {industryColumns.map((column) => (
            <div class={`industry-column ${column.direction}`}>
              <div class="industry-track">
                {Array.from({ length: 2 }).map((_, groupIndex) => (
                  <div class="industry-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                    {column.items.map(([industry, icon]) => (
                      <span class="industry-pill">
                        <i class="material-symbols-rounded" aria-hidden="true">{icon}</i>{industry}
                      </span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
