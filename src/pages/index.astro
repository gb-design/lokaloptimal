  note: "USA, 1.002 Befragte",
};

// Statistik Austria, IKT-Einsatz in Haushalten 2025: rund 40 % nutzten in den drei
// Monaten vor der Befragung generative KI (2024: 28 %). Belegt im WIFO-Monatsbericht 11/2025.
const kiSource = {
  label: "WIFO-Monatsberichte 11/2025",
  url: "https://www.wifo.ac.at/wp-content/uploads/upload-1063/mb_2025_11_03_digitalisierung.pdf",
  note: "Österreich, Daten von Statistik Austria",
};

const benefitSources = [brightLocalSource, kiSource];

const benefits = [
  {
    icon: "reviews",
    value: 97,
    decimals: 0,
    suffix: "%",
    color: "green",
    layout: "half",
    demo: "reviews",
    text: "lesen Bewertungen, bevor sie einen lokalen Betrieb wählen.",
    action: "LokalOptimal macht Ihren Eintrag vollständig und überzeugend.",
  },
  {
    icon: "smart_toy",
    prefix: "rund",
    value: 40,
    decimals: 0,
    suffix: "%",
    color: "blue",
    layout: "half",
    demo: "chat",
    text: "nutzen in Österreich KI wie ChatGPT.",
    note: "Vor einem Jahr waren es 28 %.",
