    points: ["Kundinnen und Kunden direkt vor Ort zur Bewertung führen.", "Der QR-Code öffnet den Bewertungsprozess ohne Umwege.", "Individuell mit Logo, Text und klarer Handlungsaufforderung gestaltet."],
    closingText: "Optimal für Betriebe, die zufriedene Kunden nicht dem Zufall überlassen möchten.",
  },
  {
    name: "Google Beiträge",
    title: "Google Beiträge",
    subtitle: "Aktuell bleiben. Sichtbar wirken. Vertrauen stärken.",
    icon: "article",
    image: addonArticlesImage.src,
    imageAlt: "Vorschau geplanter Google-Beiträge mit aktuellen Angeboten und Profil-Updates.",
    points: ["Regelmäßige Updates direkt im Google Business Profil veröffentlichen.", "Angebote, News oder saisonale Aktionen sichtbar platzieren.", "Ein aktives Profil wirkt gepflegter und professioneller."],
    closingText: "Ideal für Unternehmen, die regelmäßig sichtbar bleiben möchten.",
  },
  {
    name: "Landingpages",
    title: "Landingpages",
    subtitle: "Wenn der Klick nicht ins Leere laufen soll.",
    icon: "wysiwyg",
    image: addonLandingpageImage.src,
    imageAlt: "Vorschau einer kompakten Landingpage als Anschlussstrecke vom Google-Profil zur Anfrage.",
    points: ["Kompakte Seite für Unternehmen ohne starke Website.", "Klarer Aufbau mit Leistungen, Vertrauen und Kontaktmöglichkeit.", "Optimiert als Anschlussstrecke von Google Profil zur Anfrage."],
    closingText: "Perfekt, wenn das Google Profil mehr leisten soll als nur gefunden werden.",
  },
];

const packages = [
  { name: "Starter", badge: "Einmalig", price: "€347", period: "einmalig", text: "Der perfekte Einstieg für ein professionelles Profil-Setup.", items: ["GBP Audit & Analyse", "Vollständiges Profil-Setup", "Kategorien, Texte, Öffnungszeiten"] },
  { name: "Essential", badge: "Einmalig", price: "€697", period: "einmalig", text: "Das komplette Setup mit Wettbewerbs-Blick für einen starken ersten Eindruck.", items: ["Alles aus Starter", "Foto-Briefing Dokument", "1x Google Post", "Konkurrenzanalyse (3 Mitbewerber)"] },
  { name: "Growth", badge: "3 Monate", price: "€1.397", period: "3 Monate Laufzeit", text: "Aktives Management für mehr Sichtbarkeit und Interaktionen.", items: ["Alles aus Essential", "3 Monate aktives Management", "4x Google Posts / Monat", "Review-Monitoring & Antworten (bis 15 / Monat)", "Monatliches PDF-Reporting"], featured: true },
  { name: "Local Pro", badge: "6 Monate", price: "€3.497", period: "6 Monate Laufzeit", text: "Die Komplettlösung für nachhaltiges Wachstum & maximale Präsenz.", items: ["Alles aus Growth", "6 Monate aktives Management", "8x Google Posts / Monat", "Review- & Q&A Management (bis 15 / bis 10 pro Monat)", "Strategie-Call pro Monat"] },
];

const retainers = [
  { name: "Care", sub: "nach Growth", price: "€399", period: "/ Monat", tooltip: "Hält Ihr Profil nach der Erstlaufzeit dauerhaft aktiv und gepflegt – monatlich kündbar, ohne erneutes Setup.", items: ["4x Google Posts / Monat", "Review-Monitoring", "Monatliches Reporting"] },
  { name: "Pro Care", sub: "nach Local Pro", price: "€499", period: "/ Monat", tooltip: "Die dauerhafte Rundum-Betreuung für maximale Präsenz – monatlich kündbar, ohne erneutes Setup.", items: ["8x Google Posts / Monat", "Review- & Q&A Management", "Strategie-Call pro Quartal"] },
];

const addons = [
  {
    name: "Extra Google Posts",
    sub: "+4 / Monat",
    price: "€167",
    period: "/ Monat",
    tooltip: "Hält Ihr Profil sichtbar aktiv und bringt aktuelle Angebote, News oder Aktionen direkt in die Google-Suche.",
  },
  {
    name: "Review-Response Service",
    sub: "bis 15 / Monat",
    price: "€127",
    period: "/ Monat",
    tooltip: "Zeigt Interessenten, dass Ihr Unternehmen auf Feedback reagiert und Kunden ernst nimmt. Inkludiert bis zu 15 Bewertungsantworten pro Monat, jede weitere €6.",
  },
  {
    name: "Landingpage",
    sub: "1-Pager",
    price: "€1.197",
    period: "einmalig",
    tooltip: "LokalOptimal erstellt oder optimiert Ihre Website – klar, lokal sichtbar und vorbereitet für KI-Suchmaschinen. Inkl. einer Korrekturrunde.",
  },
  {
    name: "Konkurrenzanalyse",
    sub: "3 Mitbewerber",
    price: "€197",
    period: "einmalig",
    tooltip: "Macht sichtbar, wo Mitbewerber stärker auftreten und welche Chancen Ihr Profil noch nutzen kann.",
  },
  {
    name: "Foto-Briefing Dokument",
    sub: "",
    price: "€97",
    period: "einmalig",
    tooltip: "Hilft Ihnen, genau die Bilder zu erstellen, die Vertrauen aufbauen und Ihr Profil professioneller wirken lassen.",
  },
  {
    name: "Q&A Management",
    sub: "bis 10 / Monat",
    price: "€79",
    period: "/ Monat",
    tooltip: "Beantwortet typische Fragen direkt im Profil und reduziert Unsicherheit vor der Kontaktaufnahme. Inkludiert bis zu 10 Fragen pro Monat.",
  },
];

const faqs = [
  {
    question: "Was bringt eine Google Business Profil Optimierung?",
    answer: "Eine Google Business Profil Optimierung sorgt dafür, dass wichtige Informationen wie Leistungen, Öffnungszeiten, Fotos, Bewertungen und Kontaktwege vollständig, aktuell und vertrauenswürdig erscheinen. Das verbessert den ersten Eindruck in Google Suche und Google Maps und kann mehr relevante Anfragen aus lokalen Suchanfragen unterstützen.",
  },
  {
    question: "Für welche lokalen Unternehmen ist LokalOptimal geeignet?",
    answer: "LokalOptimal ist für lokale Dienstleister, Praxen, Kanzleien, Handwerksbetriebe, Restaurants, Studios und andere Unternehmen geeignet, die regional gefunden werden und aus ihrem Google Business Profil mehr Vertrauen und Kontaktanfragen gewinnen möchten.",
  },
  {
    question: "Was passiert beim kostenlosen GBP-Check?",
    answer: "Beim kostenlosen GBP-Check wird ein bestehendes Google Business Profil anhand zentraler Profilfaktoren geprüft. Dazu gehören unter anderem Basisdaten, Öffnungszeiten, Beschreibung, Fotos, Bewertungen und sichtbare Kontaktmöglichkeiten. Danach lässt sich einschätzen, wo schnelle Verbesserungen möglich sind.",
  },
  {
    question: "Gibt es Rankingversprechen?",
    answer: "Nein. LokalOptimal gibt bewusst keine Rankingversprechen. Google Suche und Google Maps hängen von vielen Faktoren ab. Ziel ist eine fachgerechte Optimierung nach aktuellen Best Practices, damit das Profil vollständiger, aktueller und überzeugender wirkt.",
  },
  {
    question: "Was bedeutet GEO für mein lokales Unternehmen?",
    answer: "GEO (Generative Engine Optimization) sorgt dafür, dass Ihr Unternehmen in KI-gestützten Antworten sichtbar wird – etwa in ChatGPT, Google AI Overviews oder Perplexity. Immer mehr Menschen fragen KI-Assistenten direkt nach lokalen Anbietern. Ein vollständiges, konsistentes und vertrauenswürdiges Google Business Profil ist dabei eine wichtige Grundlage, damit KI-Systeme Ihr Unternehmen korrekt erfassen und empfehlen können.",
  },
  {
    question: "Hilft ein optimiertes Google-Profil auch bei KI-Suchanfragen?",
    answer: "Ja. KI-Systeme greifen für lokale Empfehlungen unter anderem auf strukturierte, öffentlich verfügbare Daten zurück – dazu zählt auch das Google Business Profil. Vollständige Angaben zu Leistungen, Standort, Öffnungszeiten und Bewertungen erhöhen die Wahrscheinlichkeit, dass Ihr Unternehmen in generierten Antworten korrekt und vertrauenswürdig dargestellt wird.",
  },
];

const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "LokalOptimal",
    alternateName: "george&burn design co.",
    url: siteUrl,
    email: "lokaloptimal@gmail.com",
    founder: {
      "@type": "Person",
      name: "Georg Redl-Fortelny",
    },
    address: {
      "@type": "PostalAddress",
      streetAddress: "Lorenz-Mandl-Gasse 16",
      postalCode: "1160",
      addressLocality: "Wien",
      addressCountry: "AT",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    name: "LokalOptimal",
    url: siteUrl,
    inLanguage: "de-AT",
    publisher: {
      "@id": `${siteUrl}/#organization`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${siteUrl}/#webpage`,
    url: siteUrl,
    name: homeTitle,
    description: homeDescription,
    inLanguage: "de-AT",
    isPartOf: {
      "@id": `${siteUrl}/#website`,
    },
    about: {
      "@id": `${siteUrl}/#service`,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${siteUrl}/#service`,
    name: "Google Business Profil Optimierung",
    description: "Optimierung und Pflege von Google Business Profilen für lokale Unternehmen in Österreich.",
    provider: {
      "@id": `${siteUrl}/#organization`,
    },
    areaServed: [
      {
        "@type": "Country",
        name: "Österreich",
      },
      {
        "@type": "City",
        name: "Wien",
      },
    ],
    serviceType: "Local SEO und Google Business Profile Optimierung",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": `${siteUrl}/#faq`,
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.question,
      acceptedAnswer: {
        "@type": "Answer",
        text: faq.answer,
      },
    })),
  },
];

const testimonials = [
  {
    quote: "Das Profil wirkt endlich aufgeräumt und professionell. Besonders hilfreich war, dass wir jetzt klar sehen, welche Inhalte im Google-Profil wirklich zählen.",
    name: "Martin H.",
    company: "Steuerkanzlei Huber",
    location: "Wien",
    rating: 5,
  },
  {
    quote: "Die Optimierung hat uns geholfen, bei lokalen Suchanfragen seriöser aufzutreten. Der Ablauf war verständlich und ohne unnötigen Fachjargon.",
    name: "Sabine K.",
    company: "Praxis am Stadtpark",
    location: "Klosterneuburg",
    rating: 4,
  },
  {
    quote: "Unsere Öffnungszeiten, Leistungen und Fotos sind jetzt konsistent. Genau diese saubere Basis hat uns vorher gefehlt.",
    name: "Daniel R.",
    company: "R&R Installationen",
    location: "Wien-Umgebung",
    rating: 4,
  },
  {
    quote: "Gute Struktur und schnelle Umsetzung. Bei den laufenden Beiträgen hätten wir uns anfangs noch mehr Beispiele gewünscht, inzwischen passt es sehr gut.",
    name: "Nina F.",
    company: "Salon Frey",
    location: "Wien",
    rating: 3,
  },
  {
    quote: "Die Pflege der Bewertungen und die klareren Profilinfos machen einen spürbar besseren ersten Eindruck bei neuen Kundinnen und Kunden.",
    name: "Thomas M.",
    company: "Autohaus Mayer",
    location: "Wien-Umgebung",
    rating: 5,
  },
];
---

<BaseLayout title={homeTitle} description={homeDescription} canonicalPath="/" structuredData={homeStructuredData}>
  <Header />

  <main>
    <section class="hero">
      <div class="container-wide hero-grid">
        <div class="hero-copy reveal is-visible">
          <p class="hero-kicker">
            <span class="kicker-icon material-symbols-rounded" aria-hidden="true">trending_up</span>
            <span class="hero-kicker-text">
              <span>Boosten Sie Ihre Sichtbarkeit -</span>
              <strong>noch heute!</strong>
            </span>
          </p>
          <h1 class="h1">
            <span>Weil der erste</span>
            <span>Eindruck zählt.</span>
            <span class="text-blue">Auf Google.</span>
          </h1>
          <div class="hero-actions">
            <a class="btn btn-primary" href={calUrl} rel="noreferrer" data-cal-open>
              Kostenloses Erstgespräch
              <span class="btn-icon"><span class="material-symbols-rounded" aria-hidden="true">arrow_forward</span></span>
            </a>
            <a class="learn-link" href="#quick-check">Mehr erfahren</a>
          </div>
        </div>

        <div class="hero-visual" data-gsap="parallax" data-hero-tilt>
          <div class="hero-visual-stack">
            <img
              class="hero-browser-image"
              src={heroBrowserImage.src}
              width={heroBrowserImage.width}
              height={heroBrowserImage.height}
              alt="Google-Business-Profil in einer Kartenansicht mit Profilstärke und Standortmarker."
              loading="eager"
              decoding="async"
            />
            <div class="hero-layer hero-profile-card-layer" data-hero-layer data-depth="10">
              <img
                class="hero-profile-card-image"
                src={heroProfileCardImage.src}
                width={heroProfileCardImage.width}
                height={heroProfileCardImage.height}
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="hero-layer hero-score-card-layer" data-hero-layer data-depth="14">
              <img
                class="hero-score-card-image"
                src={heroScoreCardImage.src}
                width={heroScoreCardImage.width}
                height={heroScoreCardImage.height}
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
            <div class="hero-layer hero-pin-layer" data-hero-layer data-depth="8">
              <img
                class="hero-pin-image"
                src={heroPinImage.src}
                width={heroPinImage.width}
                height={heroPinImage.height}
                alt=""
                loading="eager"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="container trust-cluster reveal is-visible">
        <div class="trust-row">
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Mehr Sichtbarkeit</span>
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Mehr Vertrauen</span>
          <span><i class="material-symbols-rounded" aria-hidden="true">check_circle</i>Mehr Anfragen</span>
        </div>
        <span class="expert-badge"><span class="material-symbols-rounded" aria-hidden="true">hotel_class</span>Google Business Profil Experte</span>
      </div>
    </section>

    <section class="section check-section" id="quick-check">
      <div class="container section-heading" data-gsap="reveal">
        <span class="map-icon" aria-hidden="true"><span>G</span></span>
        <h2 class="h2">Machen Sie einen <span class="text-blue">kostenlosen</span> GBP-Check</h2>
        <p class="lead">Einfach bestehende Google Business Profil-URL eingeben und prüfen lassen.</p>
      </div>
      <div class="panel-shell widget-shell" data-gsap="reveal">
        <div class="panel-core widget-core">
          <GBPAuditWidget client:load />
        </div>
      </div>
    </section>

    <section class="section industries-section">
      <div class="container industries-grid">
        <div data-gsap="reveal">
          <span class="eyebrow"><span class="material-symbols-rounded" aria-hidden="true">storefront</span>Für lokale Unternehmen</span>
          <h2 class="h2">Mehr Sichtbarkeit für jede Branche</h2>
          <p class="lead"><strong>LokalOptimal</strong> hilft Unternehmen, dort besser sichtbar zu werden, wo Kund:innen aktiv suchen - auf Google.</p>
        </div>
        <div class="industry-marquee" data-gsap="reveal" aria-label="Branchen">
          {industryColumns.map((column) => (
            <div class={`industry-column ${column.direction}`}>
              <div class="industry-track">
                {Array.from({ length: 2 }).map((_, groupIndex) => (
                  <div class="industry-group" aria-hidden={groupIndex === 1 ? "true" : undefined}>
                    {column.items.map(([industry, icon]) => (
                      <span class="industry-pill">
                        <i class="material-symbols-rounded" aria-hidden="true">{icon}</i>{industry}
                      </span>
                    ))}
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section benefits-section" id="vorteile">
      <div class="container section-heading" data-gsap="reveal">
        <span class="stars" aria-label="Fünf Sterne">
          {Array.from({ length: 5 }).map(() => <span class="material-symbols-rounded" aria-hidden="true">star</span>)}
        </span>
        <h2 class="h2">Warum ein gepflegtes Google-Profil mehr ist, als ein Brancheneintrag</h2>
      </div>
      <div class="container benefit-bento" aria-label="Vorteile in Zahlen">
        {benefits.map((benefit) => (
          <article class={`benefit-stat-card is-${benefit.layout} tone-${benefit.color}`} data-gsap="reveal">
            <div class="benefit-shape" aria-hidden="true"></div>
            <div class="benefit-stat-head">
              <span class="benefit-stat-icon material-symbols-rounded" aria-hidden="true">{benefit.icon}</span>
              <strong class="benefit-stat-value">
                <span
                  data-count-up
                  data-count-target={benefit.value}
                  data-count-decimals={benefit.decimals}
                >0</span>
                <small>{benefit.suffix}</small>
              </strong>
            </div>
            <p>{benefit.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section addon-showcase" id="wirkung">
      <div class="container section-heading" data-gsap="reveal">
        <span class="eyebrow"><span class="material-symbols-rounded" aria-hidden="true">extension</span>Add-ons für mehr Wirkung</span>
        <h2 class="h2">Ergänzen Sie Ihr Profil mit <span class="text-blue">starken Add-ons</span></h2>
        <p class="lead">Maximieren Sie Vertrauen, Interaktionen und Anfragen - mit den richtigen Bausteinen für Ihren Google-Auftritt.</p>
      </div>
      <div class="container addon-grid">
        <div class="panel-shell addon-tabs" data-gsap="reveal">
          <div class="panel-core">
            <div class="tab-nav" role="tablist" aria-label="Add-ons">
              {tabs.map((tab, index) => (
                <button
                  id={`addon-tab-${index}`}
                  class={index === 0 ? "active" : ""}
                  type="button"
                  role="tab"
                  aria-selected={index === 0 ? "true" : "false"}
                  aria-controls={`addon-panel-${index}`}
                  tabindex={index === 0 ? "0" : "-1"}
                  data-tab-index={index}
                >
                  {tab.name}
                </button>
              ))}
            </div>
            {tabs.map((tab, index) => (
              <div
                id={`addon-panel-${index}`}
                class="tab-content"
                role="tabpanel"
                aria-labelledby={`addon-tab-${index}`}
                data-tab-index={index}
                hidden={index !== 0}
              >
                <div class="tab-content-head">
                  <span class="tab-icon material-symbols-rounded" aria-hidden="true">{tab.icon}</span>
                  <h3>{tab.title}</h3>
                </div>
                <div class="tab-content-body">
                  <strong>{tab.subtitle}</strong>
                  <ul>
                    {tab.points.map((point) => <li>{point}</li>)}
                  </ul>
                  <p class="tab-closing">{tab.closingText}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="review-visual panel-shell addon-visual" data-gsap="reveal">
          <div class="panel-core addon-visual-core">
            {tabs.map((tab, index) => (
              <img
                src={tab.image}
                alt={tab.imageAlt}
                loading={index === 0 ? "eager" : "lazy"}
                decoding="async"
                data-tab-index={index}
                hidden={index !== 0}
              />
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="section pricing-section" id="preise">
      <div class="container section-heading" data-gsap="reveal">
        <span class="eyebrow"><span class="material-symbols-rounded" aria-hidden="true">inventory_2</span>Unsere Pakete</span>
        <h2 class="h2">Das passende Paket für <span class="text-blue">Ihren Google-Auftritt</span></h2>
      </div>
      <div class="container-wide pricing-grid">
        {packages.map((pkg) => (
