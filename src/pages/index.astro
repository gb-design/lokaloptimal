const homeStructuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": `${siteUrl}/#organization`,
    name: "LokalOptimal",
    alternateName: "george&burn design co.",
    url: siteUrl,
    email: "lokaloptimal@gmail.com",
    founder: {
      "@type": "Person",
      name: "Georg Redl-Fortelny",
    },
