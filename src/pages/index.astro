  {
    direction: "up",
    items: industries.slice(0, 8),
  },
];

const benefits = [
  {
    icon: "search",
    value: 76,
    decimals: 0,
    suffix: "%",
    color: "green",
    layout: "tall",
    text: "Besuchen nach lokaler Suche innerhalb von 24 Stunden ein Unternehmen.",
  },
  {
    icon: "star",
    value: 88,
    decimals: 0,
