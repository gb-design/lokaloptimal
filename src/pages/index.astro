import MotionScript from "@/components/MotionScript.astro";
import HeroProfileCard from "@/components/HeroProfileCard.astro";
import HeroStreetMap from "@/components/HeroStreetMap.astro";
import GBPAuditWidget from "@/components/GBPAuditWidget";
import ContactForm from "@/components/ContactForm";
import BedarfsCheck from "@/components/BedarfsCheck";
import { addons, formatEuro, packages, quickCheck, retainers } from "@/data/pricing";
import addonArticlesImage from "../../assets/avif/addon-articles.avif";
import addonLandingpageImage from "../../assets/avif/addon-landingpage.avif";
import addonQrImage from "../../assets/avif/addon-qr.avif";
import grfProfileImage from "../../assets/avif/grf_profile.avif";

const calUrl = import.meta.env.PUBLIC_CAL_URL || "https://cal.com/DEIN-USERNAME/gbp-audit";
const siteUrl = Astro.site!.origin;
const homeTitle = "Google Business Profil Optimierung Österreich | LokalOptimal";
const homeDescription = "Mehr Anrufe über Google Maps: LokalOptimal richtet Ihr Google Business Profil ein und hält es aktuell. Festpreise ab €347, kostenloser Check, Österreich.";

const industries = [
  ["Notar", "business_center"],
  ["Hausarzt", "medical_services"],
  ["Internist", "stethoscope"],
  ["Anwalt", "balance"],
  ["Steuerberater", "query_stats"],
  ["Agenturen", "hub"],
  ["Tierarzt", "pets"],
