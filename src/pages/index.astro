          <p class="lead">Im kostenlosen Erstgespräch sehe ich mir Ihren Eintrag mit Ihnen an. Sie erfahren, was fehlt und was es kostet, das zu ändern. Unverbindlich, ohne Verkaufsdruck.</p>
          <div class="contact-actions">
            <a class="btn btn-secondary contact-cal" href={calUrl} target="_blank" rel="noopener noreferrer" data-cal-open>Kostenloses Erstgespräch buchen</a>
          </div>
          <figure class="founder-card">
            <div class="founder-avatar">
              <div class="founder-ring" aria-hidden="true"></div>
              <img
                src={grfProfileImage.src}
                width={grfProfileImage.width}
                height={grfProfileImage.height}
                alt="Georg R.-F., Gründer von LokalOptimal und Ihr persönlicher Betreuer"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="founder-info">
              <strong class="founder-name">Georg R.-F.</strong>
              <span class="founder-role">Gründer von LokalOptimal und Ihr persönlicher Betreuer</span>
              <blockquote class="founder-quote">
                <p>„Wenn jemand nach Ihrem Angebot sucht, zählt der erste Eindruck auf Google. Ich sorge dafür, dass Ihr Profil vollständig, aktuell und überzeugend wirkt – damit aus Sichtbarkeit Anfragen werden.“</p>
              </blockquote>
            </figcaption>
          </figure>
        </div>
        <div class="gbp-card">
          <div class="gbp-cover" aria-hidden="true">
            <span class="material-symbols-rounded gbp-pin">location_on</span>
          </div>
          <div class="gbp-head">
            <h3>LokalOptimal</h3>
            <p>Google-Eintrag-Betreuung · Wien · ganz Österreich</p>
          </div>
          <div class="gbp-actions">
            <span class="gbp-action is-active" aria-current="true">
              <span class="material-symbols-rounded" aria-hidden="true">mail</span>Nachricht schreiben
            </span>
            <button class="gbp-action" type="button" data-cal-open>
              <span class="material-symbols-rounded" aria-hidden="true">calendar_month</span>Termin buchen
            </button>
          </div>
          <ul class="gbp-info">
            <li><span class="material-symbols-rounded" aria-hidden="true">location_on</span>Wien und ganz Österreich</li>
            <li><span class="material-symbols-rounded" aria-hidden="true">schedule</span>Erstgespräch: 30 Minuten · kostenlos · unverbindlich</li>
          </ul>
          <div class="gbp-form">
            <h4>Nachricht senden</h4>
            <ContactForm client:visible />
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <MotionScript />
  <script>
    // Fallbeispiel: einmalige Choreografie beim Scrollen (Zahlen, Balken, Listen).
    // Ohne JS oder bei "Bewegung reduzieren" bleibt alles im Endzustand sichtbar.
    {
      const section = document.querySelector<HTMLElement>(".case-section");
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      if (section && !reduced && "IntersectionObserver" in window) {
        const counters = Array.from(section.querySelectorAll<HTMLElement>("[data-count-to]"));
        const targets = counters.map((el) => Number(el.dataset.countTo));
        counters.forEach((el) => {
          el.textContent = "0";
        });
        section.classList.add("case-animate");

        const countUp = (el: HTMLElement, to: number, delay: number, duration: number) => {
          const start = performance.now() + delay;
          const tick = (now: number) => {
            const t = Math.min(1, Math.max(0, (now - start) / duration));
            el.textContent = Math.round(to * (1 - Math.pow(1 - t, 3))).toLocaleString("de-DE");
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        };

        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            section.classList.add("is-inview");
            counters.forEach((el, i) => {
              const inLabels = Boolean(el.closest(".case-split-labels"));
              countUp(el, targets[i], inLabels ? 300 : 0, inLabels ? 1200 : 1200);
            });
          },
          { threshold: 0.3 },
        );
        observer.observe(section);
      }
    }

    // Kleine Spielerei in der Bewertungskarte: Sterne vergeben (3 bis 5, auch halbe).
    // Reiner Gag, es wird nichts gespeichert oder gesendet.
    document.querySelectorAll<HTMLElement>("[data-rate]").forEach((root) => {
      const slider = root.querySelector<HTMLElement>(".rate-stars");
      const hint = root.querySelector<HTMLElement>("[data-rate-hint]");
      if (!slider || !hint) return;
      const stars = Array.from(slider.querySelectorAll<HTMLElement>(".rate-star"));
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const MIN = 3;
      const MAX = 5;
      const format = (n: number) => n.toLocaleString("de-DE");
      let value = MIN;
      let pressing = false;

      const paint = (v: number) => {
        stars.forEach((star, i) => {
          star.style.setProperty("--fill", String(Math.min(1, Math.max(0, v - i))));
        });
      };

      const fromPointer = (event: PointerEvent) => {
        const rect = slider.getBoundingClientRect();
        const ratio = (event.clientX - rect.left) / rect.width;
        const raw = Math.ceil(Math.min(1, Math.max(0, ratio)) * MAX * 2) / 2;
        return Math.min(MAX, Math.max(MIN, raw));
      };

      const burst = (x: number, y: number) => {
        if (reducedMotion.matches) return;
        const host = root.getBoundingClientRect();
        for (let i = 0; i < 6; i++) {
          const spark = document.createElement("span");
          spark.className = "material-symbols-rounded rate-spark";
          spark.textContent = "star";
          spark.setAttribute("aria-hidden", "true");
          spark.style.left = `${x - host.left}px`;
          spark.style.top = `${y - host.top}px`;
          root.appendChild(spark);
          const angle = (-160 + Math.random() * 140) * (Math.PI / 180);
          const distance = 26 + Math.random() * 26;
          const animation = spark.animate(
            [
              { transform: "translate(-50%, -50%) scale(1)", opacity: 1 },
              {
                transform: `translate(calc(-50% + ${Math.cos(angle) * distance}px), calc(-50% + ${Math.sin(angle) * distance}px)) scale(0.35)`,
                opacity: 0,
              },
            ],
            { duration: 520 + Math.random() * 160, easing: "cubic-bezier(0.22, 1, 0.36, 1)" },
          );
          animation.onfinish = () => spark.remove();
        }
      };

      const commit = (next: number, x: number, y: number) => {
        value = next;
        paint(value);
        slider.setAttribute("aria-valuenow", String(value));
        slider.setAttribute("aria-valuetext", `${format(value)} von 5 Sternen`);
        hint.textContent = `Danke für ${format(value)} Sterne! So einfach geht das für Ihre Kunden.`;
        burst(x, y);
      };

      slider.addEventListener("pointermove", (event) => {
        if (event.pointerType === "mouse" || pressing) paint(fromPointer(event));
      });
      slider.addEventListener("pointerleave", () => {
        if (!pressing) paint(value);
      });
      slider.addEventListener("pointerdown", (event) => {
        if (event.button !== 0) return;
        pressing = true;
        slider.setPointerCapture(event.pointerId);
        paint(fromPointer(event));
      });
      slider.addEventListener("pointerup", (event) => {
        if (!pressing || event.button !== 0) return;
        pressing = false;
        commit(fromPointer(event), event.clientX, event.clientY);
      });
      slider.addEventListener("pointercancel", () => {
        pressing = false;
        paint(value);
      });

      slider.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" || event.key === "ArrowUp" ? 0.5
          : event.key === "ArrowLeft" || event.key === "ArrowDown" ? -0.5
          : 0;
        let next = value + step;
        if (event.key === "Home") next = MIN;
        else if (event.key === "End") next = MAX;
        else if (!step) return;
        event.preventDefault();
        const rect = slider.getBoundingClientRect();
        commit(Math.min(MAX, Math.max(MIN, next)), rect.left + (rect.width * next) / MAX, rect.top + rect.height / 2);
      });

      paint(value);
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-bc-offer]").forEach((link) => {
      link.addEventListener("click", () => {
        const offerId = link.dataset.bcOffer;
        if (!offerId) return;
        try {
          window.sessionStorage.setItem("bedarfscheck-preselect", offerId);
        } catch {
          // Storage kann in gehärteten Browsern gesperrt sein.
        }
        window.dispatchEvent(new CustomEvent("bedarfscheck:preselect", { detail: offerId }));
      });
    });

    document.querySelectorAll<HTMLElement>(".addon-tabs").forEach((tabsRoot) => {
      const addonGrid = tabsRoot.closest<HTMLElement>(".addon-grid");
      const tabs = Array.from(tabsRoot.querySelectorAll<HTMLButtonElement>("[role='tab']"));
      const panels = Array.from(tabsRoot.querySelectorAll<HTMLElement>("[role='tabpanel']"));
      const images = Array.from(addonGrid?.querySelectorAll<HTMLImageElement>(".addon-visual img") ?? []);
      const progressFill = tabsRoot.querySelector<HTMLElement>(".tab-progress-fill");
      const autoplayToggle = addonGrid?.querySelector<HTMLButtonElement>("[data-addon-autoplay]");
      const autoplayToggleIcon = autoplayToggle?.querySelector<HTMLElement>(".material-symbols-rounded");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

      let currentIndex = 0;
      let autoplayActive = false;
      let autoplayStopped = false;

      // "user" kommt vom Pause/Play-Knopf; Hover pausiert bewusst nicht.
      const pauseState = { user: false, focus: false, offscreen: true, hiddenDoc: false };

      const syncToggle = () => {
        if (!autoplayToggle) return;
        const label = pauseState.user ? "Automatischen Wechsel starten" : "Automatischen Wechsel pausieren";
        autoplayToggle.setAttribute("aria-label", label);
        autoplayToggle.title = label;
        if (autoplayToggleIcon) autoplayToggleIcon.textContent = pauseState.user ? "play_arrow" : "pause";
      };

      const syncPaused = () => {
        tabsRoot.classList.toggle(
          "is-paused",
          autoplayActive && Object.values(pauseState).some(Boolean),
        );
      };

      const restartProgress = () => {
        if (!progressFill) return;
        progressFill.classList.remove("is-animating");
        void progressFill.offsetWidth;
        progressFill.classList.add("is-animating");
      };

      const stopAutoplay = () => {
        autoplayActive = false;
        autoplayStopped = true;
        tabsRoot.classList.remove("is-paused");
        progressFill?.classList.remove("is-animating");
        if (autoplayToggle) autoplayToggle.hidden = true;
      };

      const pauseByUser = () => {
        pauseState.user = true;
        syncToggle();
        syncPaused();
      };

      const activateTab = (nextIndex: number, shouldFocus = false) => {
        currentIndex = nextIndex;

        tabs.forEach((tab, index) => {
          const isActive = index === nextIndex;
          tab.classList.toggle("active", isActive);
          tab.setAttribute("aria-selected", String(isActive));
          tab.tabIndex = isActive ? 0 : -1;
          if (isActive && shouldFocus) tab.focus();
        });

        panels.forEach((panel, index) => {
          panel.hidden = index !== nextIndex;
        });

        images.forEach((image, index) => {
          image.hidden = index !== nextIndex;
        });
      };

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => {
          activateTab(index);
          if (!autoplayActive) return;
          pauseByUser();
          restartProgress();
        });
        tab.addEventListener("keydown", (event) => {
          const lastIndex = tabs.length - 1;
          let nextIndex = index;

          if (event.key === "ArrowRight") nextIndex = index === lastIndex ? 0 : index + 1;
          else if (event.key === "ArrowLeft") nextIndex = index === 0 ? lastIndex : index - 1;
          else if (event.key === "Home") nextIndex = 0;
          else if (event.key === "End") nextIndex = lastIndex;
          else return;

          event.preventDefault();
          activateTab(nextIndex, true);
          if (!autoplayActive) return;
          pauseByUser();
          restartProgress();
        });
      });

      if (progressFill && addonGrid && !reducedMotion.matches) {
        progressFill.addEventListener("animationend", () => {
          if (!autoplayActive) return;
          activateTab((currentIndex + 1) % tabs.length);
          restartProgress();
        });

        if (autoplayToggle) {
          autoplayToggle.hidden = false;
          autoplayToggle.addEventListener("click", () => {
            pauseState.user = !pauseState.user;
            syncToggle();
            syncPaused();
          });
        }

        tabsRoot.addEventListener("focusin", () => {
          pauseState.focus = true;
          syncPaused();
        });
        tabsRoot.addEventListener("focusout", () => {
          pauseState.focus = false;
          syncPaused();
        });

        document.addEventListener("visibilitychange", () => {
          pauseState.hiddenDoc = document.hidden;
          syncPaused();
        });

        reducedMotion.addEventListener("change", (event) => {
          if (event.matches) stopAutoplay();
        });

        const observer = new IntersectionObserver(
          (entries) => {
            const isVisible = entries.some((entry) => entry.isIntersecting);
            pauseState.offscreen = !isVisible;

            if (isVisible && !autoplayActive && !autoplayStopped) {
              autoplayActive = true;
              restartProgress();
            }

            syncPaused();
          },
          { threshold: 0.35 },
        );
        observer.observe(addonGrid);
      }
    });
  </script>
</BaseLayout>
