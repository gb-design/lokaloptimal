const steps = [
  {
    title: "Kostenlos prüfen",
    text: "Fügen Sie den Link zu Ihrem Google-Business-Profil ein. Sie sehen sofort, was fehlt. Noch kein Eintrag? Dann starten wir direkt mit dem Erstgespräch.",
  },
  {
    title: "LokalOptimal richtet alles ein",
    text: "Kategorien, Leistungen, Öffnungszeiten, Beschreibung und Fotos – vollständig und korrekt. Sie liefern die Infos, ich erledige den Rest.",
  },
  {
    title: "Alles aus einer Hand",
    text: "Regelmäßige Beiträge, Antworten auf Ihre Bewertungen und ein monatlicher Bericht. Sie sehen, was passiert, und müssen nichts selbst machen.",
  },
];

// Fallbeispiel: echte Werte aus der Google-Leistungsübersicht (Mai–Oktober 2026),
// veröffentlicht mit Zustimmung des Kunden. Nur mit echten Daten aktualisieren.
const caseStudy = {
  client: "Univ.-Prof. Dr. René H. Fortelny",
  period: "Mai bis Oktober 2026",
  views: 271,
  figures: [
    { value: "271", label: "Aufrufe des Profils" },
    { value: "102", label: "Kundeninteraktionen: Anrufe, Routen und Website-Klicks" },
    { value: "Mai 2026", label: "eingerichtet und verifiziert" },
  ],
  // Reihenfolge so, dass "Suche" und "Maps" im Punkteraster zusammenhängen.
  platforms: [
    { label: "Google Suche · Smartphone", surface: "search", device: "mobile", value: 110 },
    { label: "Google Suche · Computer", surface: "search", device: "desktop", value: 92 },
    { label: "Google Maps · Computer", surface: "maps", device: "desktop", value: 37 },
    { label: "Google Maps · Smartphone", surface: "maps", device: "mobile", value: 32 },
  ],
  before: [
    "Kein Google-Eintrag für die neue Ordination",
    "Keine Fotos, Öffnungszeiten oder Leistungen bei Google",
    "Kein Anruf- und kein Routen-Button",
  ],
  after: [
    "Eintrag eingerichtet und im Mai 2026 verifiziert",
    "Kategorie Chirurg mit passenden Unterkategorien",
    "Praxisfotos, Öffnungszeiten und Leistungen",
    "Website, Telefon und Route verknüpft",
  ],
};

const caseSurfaces = [
  { key: "search", label: "Google Suche" },
  { key: "maps", label: "Google Maps" },
].map((surface) => {
  const value = caseStudy.platforms
    .filter((platform) => platform.surface === surface.key)
    .reduce((sum, platform) => sum + platform.value, 0);
  return { ...surface, value, share: Math.round((value / caseStudy.views) * 100) };
});

const tabs = [
  {
    name: "QR Review Trigger",
