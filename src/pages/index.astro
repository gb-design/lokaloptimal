  },
  {
    icon: "star",
    value: 47,
    decimals: 0,
    suffix: "%",
    color: "amber",
    layout: "half",
    demo: "rate",
    text: "wählen keinen Betrieb mit weniger als 20 Bewertungen.",
    action: "Der QR-Aufsteller von LokalOptimal macht es zufriedenen Kunden leicht, Sie zu bewerten.",
