  { name: "Selin", stars: 5, text: "Kurzfristig einen Termin für Wimpern im 7. Bezirk bekommen. Gerne wieder!" },
  { name: "Markus", stars: 4, text: "Klare Aufklärung vor dem Eingriff, Praxis im 9. Bezirk. Sehr angenehm." },
  { name: "Julia", stars: 5, text: "Die Kosmetikerin hat sich Zeit genommen und ehrlich beraten." },
