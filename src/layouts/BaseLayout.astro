---
// Icon-Schrift selbst gehostet (keine Anfrage an Google Fonts); full.css enthaelt FILL, wght, opsz und GRAD.
import "@fontsource-variable/material-symbols-rounded/fill.css";
import "../styles/global.css";
import favicon from "../../assets/pngs/lo_fav.png";
import defaultOgImage from "../../assets/pngs/addon-landingpage.png";

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title = "LokalOptimal - Google Business Profil Optimierung",
  description = "LokalOptimal optimiert Google Business Profile für lokale Unternehmen, damit mehr Sichtbarkeit, Vertrauen und Anfragen entstehen.",
  canonicalPath = "/",
  structuredData,
  noindex = false,
} = Astro.props;

// Einzige Quelle fuer die Domain ist `site` in astro.config.mjs.
const siteUrl = Astro.site!.origin;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const ogImageUrl = new URL(defaultOgImage.src, siteUrl).toString();
const structuredDataItems = structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : [];
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href="/fonts/google-sans/GoogleSans-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/google-sans/GoogleSans-700.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#4965f5" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="de_AT" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <title>{title}</title>
    <script is:inline>
      // Consent Mode v2: alles verweigert, bis CookieYes eine Einwilligung meldet.
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", {
        ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied",
        analytics_storage: "denied", functionality_storage: "denied",
        personalization_storage: "denied", security_storage: "granted",
        wait_for_update: 2000,
      });
      gtag("set", "ads_data_redaction", true);
      gtag("set", "url_passthrough", false);
    </script>
    <!-- Start cookieyes banner -->
    <script is:inline id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/16a98acd4297ce348c47650676c03ad7/script.js"></script>
    <!-- End cookieyes banner -->
    <!-- Google tag (gtag.js): von CookieYes blockiert, bis Analyse-Einwilligung vorliegt -->
    <script is:inline type="text/plain" data-cookieyes="cookieyes-analytics" async src="https://www.googletagmanager.com/gtag/js?id=G-QWR2LWBX63"></script>
    <script is:inline type="text/plain" data-cookieyes="cookieyes-analytics">gtag("js", new Date()); gtag("config", "G-QWR2LWBX63");</script>
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <slot />
  </body>
</html>
